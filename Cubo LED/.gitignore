# === PlatformIO ===
# Carpeta de compilación, binarios (.elf, .bin, .hex) y librerías descargadas
.pio/
.pioenvs/
.piolibdeps/

# Base de datos de autocompletado y configuración local de PlatformIO
.clangd/
.gcc-flags.json

# === VS Code / Editores ===
# Bases de datos temporales de C/C++ generadas en VS Code
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# === Python (si usas scripts de automatización o entornos virtuales) ===
__pycache__/
*.py[cod]
venv/
env/
.env

# === Archivos del Sistema Operativo ===
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini